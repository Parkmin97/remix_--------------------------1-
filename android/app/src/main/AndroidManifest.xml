<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            차단 화면 — 2026-08-07 추가
            별도 태스크로 띄워 원래 앱과 섞이지 않게 한다.
            excludeFromRecents: 최근 앱 목록에 남지 않게 (남으면 우회 경로가 된다)
        -->
        <activity
            android:name=".BlockOverlayActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=".block"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <!--
            차단 감시 서비스 — 2026-08-07 추가
            foregroundServiceType: 안드로이드 14+ 필수. specialUse 는 구글에 용도 소명이 필요하다.
        -->
        <service
            android:name=".BlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="사용자가 스스로 설정한 앱 차단을 유지하기 위해 포그라운드 앱을 감시합니다" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        차단 엔진용 권한 — 2026-08-07 추가

        두 권한 모두 앱이 팝업으로 받을 수 없다.
        사용자가 시스템 설정 화면에 직접 들어가서 켜야 한다. (PermissionHelper 참고)
    -->

    <!-- 어떤 앱이 지금 화면에 떠 있는지 알아내기 위해 필요.
         접근성 서비스를 쓰지 않는 이유가 이것 때문이다(정책 위반 회피). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 다른 앱 위에 차단 화면을 띄우기 위해 필요.
         안드로이드 10부터 백그라운드에서 화면을 띄울 수 없는데, 이 권한이 예외다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 백그라운드 감시 서비스 실행용 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 상시 알림 표시 (안드로이드 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        설치된 앱 목록 조회 (차단 대상 선택용) — 2026-08-07 추가

        안드로이드 11(API 30)부터 다른 앱의 존재가 기본적으로 가려진다.
        아래처럼 LAUNCHER intent 를 선언하면 "홈 화면에 아이콘이 있는 앱" 전체를 조회할 수 있다.

        ⚠️ QUERY_ALL_PACKAGES 를 쓰지 않는다.
           그 권한은 런처·백신·파일관리자 등에만 허용되며, 구글 정책상
           "더 좁은 방법으로 가능한 경우" 사용이 금지되어 있다.
           우리에게는 아래 방식이 그 '더 좁은 방법'에 해당한다.

        ⚠️ 이 방식이 향후 안드로이드 버전에서 조여질 수 있으므로,
           앱 목록 조회 로직은 AppListHelper 한 곳에만 둔다(교체 용이).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
